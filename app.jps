
const signals = [];
const operations = [];
const history = [];

let selectedMarket = null;
let signalCounter = 0;

function selectMarket(name, symbol) {
  selectedMarket = { name, symbol };

  document.querySelectorAll(".market").forEach(card => {
    card.classList.toggle("active", card.dataset.symbol === symbol);
  });

  document.getElementById("chart-title").textContent = name;
  document.getElementById("chart-message").textContent =
    "Cargando velas de un minuto...";

  if (typeof openMarket === "function") openMarket(symbol);
}

function addSignal(data) {
  if (!data || !data.symbol || data.entry == null ||
      data.sl == null || data.tp == null) return;

  if (signals.some(s =>
    s.symbol === data.symbol && s.status === "ACTIVE"
  )) return;

  signalCounter++;

  signals.unshift({
    id: "SIG-" + String(signalCounter).padStart(4, "0"),
    createdAt: Date.now(),
    status: "ACTIVE",
    ...data
  });

  renderSignals();
}

function markEntered(id) {
  const signal = signals.find(s => s.id === id);
  if (!signal || signal.status !== "ACTIVE") return;

  signal.status = "ENTERED";

  operations.unshift({
    ...signal,
    enteredAt: Date.now(),
    currentPrice: Number(signal.entry),
    result: "OPEN"
  });

  renderSignals();
  renderOperations();
}

function markIgnored(id) {
  const signal = signals.find(s => s.id === id);
  if (!signal || signal.status !== "ACTIVE") return;

  signal.status = "IGNORED";

  history.unshift({
    ...signal,
    result: "NO ENTRÉ",
    finishedAt: Date.now()
  });

  renderSignals();
  renderHistory();
}

function updateOperationPrice(symbol, price) {
  operations.forEach(op => {
    if (op.symbol !== symbol || op.result !== "OPEN") return;

    op.currentPrice = Number(price);

    const hitTP = op.direction === "COMPRAR"
      ? price >= Number(op.tp)
      : price <= Number(op.tp);

    const hitSL = op.direction === "COMPRAR"
      ? price <= Number(op.sl)
      : price >= Number(op.sl);

    if (hitTP || hitSL) {
      op.result = hitTP ? "GANADA" : "PERDIDA";
      op.finishedAt = Date.now();
      history.unshift({ ...op });
    }
  });

  renderOperations();
  renderHistory();
}

function expireSignal(id) {
  const signal = signals.find(s => s.id === id);
  if (!signal || signal.status !== "ACTIVE") return;

  signal.status = "EXPIRED";

  history.unshift({
    ...signal,
    result: "CADUCADA",
    finishedAt: Date.now()
  });

  renderSignals();
  renderHistory();
}

function renderSignals() {
  const area = document.getElementById("signals");
  const active = signals.filter(s => s.status === "ACTIVE");

  document.getElementById("signal-count").textContent = active.length;

  if (!active.length) {
    area.innerHTML =
      '<div class="empty-state">No hay señales activas.</div>';
    return;
  }

  area.innerHTML = active.map(s => `
    <article class="signal-card">
      <div class="muted">${s.id} · ${s.market || s.symbol}</div>
      <h3 class="${s.direction === "COMPRAR" ? "buy" : "sell"}">
        ${s.direction}
      </h3>
      <div class="levels">
        <div class="level">
          <span>ENTRADA</span><strong>${s.entry}</strong>
        </div>
        <div class="level">
          <span>STOP LOSS</span><strong>${s.sl}</strong>
        </div>
        <div class="level">
          <span>TAKE PROFIT</span><strong>${s.tp}</strong>
        </div>
      </div>
      <div class="muted">Calidad: ${s.quality ?? "--"}/100</div>
      <div class="action-row">
        <button class="enter-button"
          onclick="markEntered('${s.id}')">ENTRÉ</button>
        <button class="ignore-button"
          onclick="markIgnored('${s.id}')">NO ENTRÉ</button>
      </div>
    </article>
  `).join("");
}

function renderOperations() {
  const area = document.getElementById("operations");
  const open = operations.filter(op => op.result === "OPEN");

  document.getElementById("operation-count").textContent = open.length;

  if (!open.length) {
    area.innerHTML =
      '<div class="empty-state">No tienes operaciones en seguimiento.</div>';
    return;
  }

  area.innerHTML = open.map(op => `
    <article class="operation-card">
      <div class="muted">${op.id} · ${op.market || op.symbol}</div>
      <h3>${op.direction}</h3>
      <p>Entrada: ${op.entry}</p>
      <p>Precio actual: <strong>${op.currentPrice}</strong></p>
      <p>SL: ${op.sl} · TP: ${op.tp}</p>
      <span class="result-warning">EN SEGUIMIENTO</span>
    </article>
  `).join("");
}

function renderHistory() {
  const area = document.getElementById("history");

  if (!history.length) {
    area.innerHTML =
      '<div class="empty-state">Sin resultados registrados.</div>';
    return;
  }

  area.innerHTML = history.map(item => `
    <article class="history-card">
      <strong>${item.market || item.symbol}</strong>
      <p>${item.direction || ""} · ${item.result}</p>
      <span class="${
        item.result === "GANADA" ? "result-win" :
        item.result === "PERDIDA" ? "result-loss" :
        "result-warning"
      }">${item.result}</span>
    </article>
  `).join("");
}
